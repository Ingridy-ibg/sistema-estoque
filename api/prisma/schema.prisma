generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model categorias {
  id        Int        @id @default(autoincrement())
  nome      String     @db.VarChar(100)
  descricao String?
  produtos  produtos[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model movimentacoes {
  id         Int      @id @default(autoincrement())
  produto_id Int
  usuario_id Int
  tipo       String   @db.VarChar(10)
  quantidade Decimal  @db.Decimal(10, 2)
  motivo     String?
  criado_em  DateTime @default(now()) @db.Timestamp(6)
  produtos   produtos @relation(fields: [produto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios   usuarios @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model produtos {
  id                Int             @id @default(autoincrement())
  categoria_id      Int?
  nome              String          @db.VarChar(150)
  unidade_medida    String          @db.VarChar(20)
  quantidade_atual  Decimal         @default(0) @db.Decimal(10, 2)
  quantidade_minima Decimal         @default(0) @db.Decimal(10, 2)
  preco_unitario    Decimal         @db.Decimal(10, 2)
  ativo             Boolean         @default(true)
  movimentacoes     movimentacoes[]
  categorias        categorias?     @relation(fields: [categoria_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model usuarios {
  id            Int             @id @default(autoincrement())
  nome          String          @db.VarChar(100)
  email         String          @unique @db.VarChar(150)
  senha_hash    String
  movimentacoes movimentacoes[]
}
