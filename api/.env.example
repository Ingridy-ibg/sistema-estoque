# Copie para .env e preencha. O .env nunca é versionado.
# A API valida as duas primeiras no boot (src/main.ts) e não sobe se faltarem.

# --- Banco de dados ---
# Única fonte de configuração de conexão: usada pelo CLI do Prisma
# (migrate/generate, via prisma.config.ts) e em execução pelo PrismaService.
#
# Local, usando o docker-compose da raiz (porta 5434):
DATABASE_URL="postgresql://estoque_user:estoque_pass@localhost:5434/estoque_db"
#
# Em provedores gerenciados, inclua os parâmetros de SSL que eles pedem, ex.:
# DATABASE_URL="postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require"

# --- Autenticação ---
# Segredo usado para assinar e verificar os tokens JWT.
# Gere um valor longo e aleatório, por exemplo: openssl rand -base64 48
JWT_SECRET=""

# --- Servidor ---
# Porta em que a API escuta. Opcional — o padrão é 3000.
PORT=3000
